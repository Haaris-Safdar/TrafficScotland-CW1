<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Enforce consistent Light theme across all system appearance settings -->
    <style name="Base.Theme.CW1TrafficApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- High contrast text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Remove default Material3 purple pill on bottom nav -->
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1A005EB8</item>
    </style>

    <style name="Theme.CW1TrafficApp" parent="Base.Theme.CW1TrafficApp" />
</resources>